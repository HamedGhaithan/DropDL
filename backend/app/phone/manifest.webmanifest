{
  "name": "DropDL Phone Link",
  "short_name": "DropDL",
  "description": "Send links to DropDL on your PC and save the results to this phone.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#070A12",
  "theme_color": "#070A12",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"}
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {"title": "title", "text": "text", "url": "url"}
  }
}
