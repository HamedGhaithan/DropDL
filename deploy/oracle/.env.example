# Copy to .env and edit.
# Your public address. A free one works: create a name at https://www.duckdns.org and point it at the server's public IP.
DOMAIN=downloads.example.com
# Optional: a https:// or mailto: link shown in the page footer as "Report abuse".
ABUSE_CONTACT=
# "on" tries YouTube too. From a datacenter address it usually fails with a bot check unless YTDLP_PROXY is a residential proxy.
YOUTUBE=off
# Optional outbound proxy for yt-dlp, e.g. socks5h://user:pass@host:1080
YTDLP_PROXY=
